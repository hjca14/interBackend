# Copy this file to .env for local development.
# Never put real account IDs, keys, certificates or personal data in this file
# or in any file that is committed to this public repository.

# AWS account ID used by the CDK app. Fictitious placeholder value below
# (the well-known example account ID used throughout AWS's own documentation).
# In real usage this should come from your shell / AWS profile, not from a
# committed file.
CDK_DEFAULT_ACCOUNT=123456789012

# AWS region. sa-east-1 (South America / Sao Paulo) is the project default,
# used automatically when this variable is unset.
CDK_DEFAULT_REGION=sa-east-1

# Named AWS CLI profile to use locally (fictitious example name).
AWS_PROFILE=interbridge-dev

# Deployment environment. Only "dev" is a valid value at this phase.
INTERBRIDGE_ENVIRONMENT=dev
